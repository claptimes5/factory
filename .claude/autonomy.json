{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(docs/factory/**)",
      "Edit(**/REVIEW.md)",
      "Edit(**/RISK.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/AGENTS.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["~/.cache", "~/.npm", "~/.asdf/installs/golang", "~/go"]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "*.githubusercontent.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ],
      "tlsTerminate": {}
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "mask",
          "extract": "oauth_token:\\s*(\\S+)",
          "injectHosts": ["api.github.com", "github.com"]
        }
      ]
    }
  }
}

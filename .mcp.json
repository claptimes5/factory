{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://127.0.0.1:8090;http://127.0.0.1:8098;http://127.0.0.1:8099;http://localhost:5173",
        "--output-dir",
        ".playwright-mcp"
      ],
      "env": {
        "npm_config_ignore_scripts": "true"
      }
    }
  }
}

{
  "name": "factory-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../internal/web/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check-styles": "node scripts/check-styles.mjs",
    "build": "npm run gen && tsc --noEmit && npm run check-styles && vite build",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff2html": "3.4.56",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
